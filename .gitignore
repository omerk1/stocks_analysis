# Data files (raw/processed data shouldn't live in git)
data/raw/*
data/processed/*
data/features/*
data/models/*
data/derived/*
!data/**/.gitkeep
*.sqlite
*.db
*.csv
*.parquet

# sr_lines CLI review charts (generated output, not source)
review_*.html

# Generated chart/analysis outputs (regenerable from src/*/plotting.py +
# the DBs, not source -- same reasoning as review_*.html above)
output/*
!output/**/.gitkeep

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
env/
ENV/
.venv
stocks_analysis_venv/

# Jupyter Notebook
.ipynb_checkpoints
*.ipynb_checkpoints/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Model files (too large for git)
*.pkl
*.joblib
*.h5
*.pt
*.pth

# Logs
logs/
*.log

# Claude Code settings (local overrides are personal, project settings are shared)
.claude/settings.local.json

# API keys and secrets
.env
secrets.json
config.local.yaml

# Testing / tooling caches
.pytest_cache/
.mypy_cache/
.coverage

# Temporary files
tmp/
temp/
*.tmp
